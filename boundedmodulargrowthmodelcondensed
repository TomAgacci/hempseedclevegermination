"""
BOUNDED MODULAR-GROWTH MODEL

Biological interpretation:
SEED -> GERMINATION -> COAT SPLIT -> RADICLE -> VEGETATIVE MODULE
-> BOUNDED MODULAR GROWTH -> REPRODUCTIVE DEVELOPMENT -> NEW SEED

"Modular splitting" represents vegetative/meristematic growth, not literal
seed production. Reproductive phenotype is kept separate from germination.
Environmental constants below are simulation parameters, not cultivation doses.
"""

from math import exp
from dataclasses import dataclass


def clamp01(x):
    return max(0.0, min(1.0, x))


# ============================================================
# ENVIRONMENT / PRESSURE-CHEM RESPONSE
# ============================================================

N_OPT, N_WIDTH = 5.0, 5.0
S_REF = 5.0
T_OPT, T_WIDTH = 24.0, 7.0
AW_OPT, AW_WIDTH = 0.98, 0.035


def omega(N, S, T, aw):
    """Bounded environmental multiplier: 0 <= Omega <= 1."""
    f_nitrate = exp(-((N - N_OPT) / N_WIDTH) ** 2)
    f_salt = exp(-0.06 * max(0.0, S - S_REF))
    f_temp = exp(-((T - T_OPT) / T_WIDTH) ** 2)
    f_water = exp(-((aw - AW_OPT) / AW_WIDTH) ** 2)

    return clamp01(f_nitrate * f_salt * f_temp * f_water)


# ============================================================
# ONE-TIME SEED -> FIRST MODULE TRANSITION
# ============================================================

def seed_to_module(viability, environment, establishment=0.90):
    p_germ = clamp01(viability * environment)
    p_split = clamp01(p_germ * 0.95)
    p_radicle = clamp01(p_split * 0.92)
    p_module = clamp01(p_radicle * establishment)

    return {
        "germination": p_germ,
        "coat_split": p_split,
        "radicle": p_radicle,
        "module_1": p_module,
    }


# ============================================================
# BOUNDED VEGETATIVE MODULE ENGINE
#
# M(t+1) = M(t)
#          + r*M(t)*(1-M(t)/K)*Omega
#          - losses
#
# Maximum logistic production occurs around M = K/2.
# ============================================================

@dataclass
class ModularPopulation:
    modules: float = 1.0
    carrying_capacity: float = 100.0
    growth_rate: float = 0.35
    loss_rate: float = 0.02


def modular_step(pop, environment):
    M = pop.modules
    K = pop.carrying_capacity
    r = pop.growth_rate

    gross_growth = r * M * (1.0 - M / K) * environment
    losses = pop.loss_rate * M

    pop.modules = max(
        0.0,
        min(K, M + gross_growth - losses)
    )

    return {
        "modules": pop.modules,
        "new_modules": gross_growth,
        "losses": losses,
        "capacity_used": pop.modules / K,
    }


# ============================================================
# REPRODUCTIVE STATE
#
# Do NOT model nitrate as:
#     if nitrate > X: sex = "intersex"
#
# Sex/intersex expression is downstream of vegetative growth
# and is not determined by this nitrate-growth equation.
# ============================================================

class ReproductiveState:
    VEGETATIVE = "vegetative"
    FEMALE = "female"
    MALE = "male"
    INTERSEX = "intersex"


def reproductive_seed_model(
    reproductive_sites,
    pollination_probability,
    fertilization_probability,
    maturation_probability
):
    p_seed = clamp01(
        pollination_probability
        * fertilization_probability
        * maturation_probability
    )

    return {
        "mature_seed_probability": p_seed,
        "expected_seed_output": reproductive_sites * p_seed,
    }


# ============================================================
# ZERO-CIRCLE REDUCTION
#
# Z0 = Seed
# Z1 = Activated embryo
# Z2 = Established vegetative module
# Z3 = Renewable bounded modular population
#
# Z0 --germination--> Z1
# Z1 --establishment--> Z2
# Z2 --bounded modular growth--> Z3
#
# A true new seed requires a separate reproductive pathway:
#
# Z3 -> reproductive development
#    -> pollination/fertilization
#    -> embryo development
#    -> mature seed
#    -> Z0
# ============================================================


# ============================================================
# EXAMPLE SIMULATION
# ============================================================

N = 5.0
S = 10.0
T = 22.0
aw = 0.97

env = omega(N, S, T, aw)

seed = seed_to_module(
    viability=0.80,
    environment=env,
    establishment=0.90,
)

plant = ModularPopulation(
    modules=1.0,
    carrying_capacity=100.0,
    growth_rate=0.35,
    loss_rate=0.02,
)

print("Omega =", round(env, 3))

print("\nSEED -> MODULE")
for state, probability in seed.items():
    print(f"{state:12s} = {probability:.3f}")

print("\nBOUNDED MODULAR GROWTH")

for cycle in range(25):
    result = modular_step(plant, env)

    print(
        f"Cycle {cycle:02d} | "
        f"Modules={result['modules']:6.2f} | "
        f"New={result['new_modules']:5.2f} | "
        f"Loss={result['losses']:5.2f} | "
        f"Capacity={100 * result['capacity_used']:5.1f}%"
    )


# ============================================================
# MODEL FLOW
# ============================================================
#
# SEED
#   |
#   v
# GERMINATION
#   |
#   v
# COAT SPLIT
#   |
#   v
# RADICLE
#   |
#   v
# MODULE M1
#   |
#   v
# +---------------------------+
# | BOUNDED MODULAR ENGINE    |
# |                           |
# | M' = M +                  |
# | r*M*(1-M/K)*Omega-losses  |
# +---------------------------+
#   |
#   +----> M2
#   +----> M3
#   +----> ...
#   +----> Mn
#   |
#   v
# REPRODUCTIVE DEVELOPMENT
#   |
#   v
# POLLINATION / FERTILIZATION
#   |
#   v
# EMBRYO DEVELOPMENT
#   |
#   v
# MATURE SEED
#
# Core rule:
# seed splitting occurs once per seed;
# continuing "cleaving" is modeled as bounded vegetative module growth.
# ============================================================
